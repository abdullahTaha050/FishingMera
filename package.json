{
  "name": "mera",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "mobile": "npm --workspace @mera/mobile run start",
    "mobile:android": "npm --workspace @mera/mobile run android",
    "mobile:ios": "npm --workspace @mera/mobile run ios"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/node": "^24.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "pgsql-parser": "^18.2.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "dependencies": {
    "expo": "~57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
